# 우리업무 (workwoori.ggm.kr) 설정
# 이 파일을 .env 로 복사해서 채우세요:  cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
# 데이터베이스
# ─────────────────────────────────────────────────────────────────────────────
# 우리동네 직업계고와 같은 PostgreSQL 을 씁니다. 표 이름이 work_ 로 시작해서
# 서로 안 겹치고, 백업도 한 번에 됩니다.
#   /root/hs-portal/backend/.env 의 DATABASE_URL 줄을 그대로 복사하세요.
# **비워 두면 조용히 빈 SQLite 파일로 떨어집니다.** 반드시 채우세요.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 로그인
# ─────────────────────────────────────────────────────────────────────────────
# 토큰 서명키. 비워 두면 재시작할 때마다 새로 만들어져 전원 로그아웃됩니다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WORK_SECRET_KEY=

# 첫 관리자. 관리자가 하나도 없을 때만 이 값으로 하나 만듭니다.
# 이미 있으면 아무 일도 안 하므로, 만든 뒤에는 지워도 됩니다.
WORK_ADMIN_ID=
WORK_ADMIN_PASSWORD=
WORK_ADMIN_NAME=관리자

# 로그인 유지 시간(시간).
WORK_TOKEN_HOURS=12

# ─────────────────────────────────────────────────────────────────────────────
# 근무
# ─────────────────────────────────────────────────────────────────────────────
# 이 시각을 넘겨 그날 처음 접속하면 '지각'으로 표시합니다.
WORK_START_TIME=09:00

# ─────────────────────────────────────────────────────────────────────────────
# 서버 상태 (관리자 화면에 표시)
# ─────────────────────────────────────────────────────────────────────────────
# 우리동네 직업계고 백엔드의 감시 API 를 대신 불러옵니다.
# backend/.env 의 MONITOR_TOKEN 과 같은 값을 넣으세요.
# 비워 두면 관리자 화면에서 서버 카드만 안 보이고, 나머지는 그대로 돕니다.
MONITOR_TOKEN=
#MONITOR_URL=http://127.0.0.1:8000

# ─────────────────────────────────────────────────────────────────────────────
# 방문 통계
# ─────────────────────────────────────────────────────────────────────────────
# 볼 사이트 = nginx 로그 파일 이름 조각. 순서가 화면 순서입니다.
#   /var/log/nginx/udt.access.log   -> 우리동네 직업계고
#   /var/log/nginx/diary.access.log -> 기록해
#VISIT_SITES=우리동네 직업계고=udt,기록해=diary
#VISIT_LOG_DIR=/var/log/nginx

# ─────────────────────────────────────────────────────────────────────────────
# 정산 (매출 자동 집계)
# ─────────────────────────────────────────────────────────────────────────────
# 우리동네 직업계고 결제 기록은 위 DATABASE_URL 과 같은 DB 라 비워 둬도 됩니다.
#SALES_UDJ_DATABASE_URL=
# 기록해는 DB 가 따로입니다. diary-backend/.env 의 DATABASE_URL 을 넣으세요.
# 비워 두면 기록해 매출은 자동으로 안 잡히고, 화면에 경고가 뜨며 마감이 막힙니다.
SALES_DIARY_DATABASE_URL=
