# ── 기록해(diary.ggm.kr) 백엔드 설정 ──────────────────

# 자체 DB. UDJ 와 다른 데이터베이스를 쓴다.
DATABASE_URL=postgresql://udt:비밀번호@localhost:5432/diary

# 토큰 서명 키. UDJ 와 다른 값을 쓴다.
SECRET_KEY=길고-무작위한-문자열로-바꾸세요

# ── 계정 연동 (UDJ) ──────────────────────────────────
# 계정의 원본은 UDJ 다. 가입·로그인·탈퇴를 이곳으로 넘긴다.
UDJ_API_BASE=http://127.0.0.1:8000
# UDJ 의 backend/.env 에 넣은 PARTNER_SECRET 과 똑같아야 한다.
PARTNER_SECRET=충분히-긴-무작위-문자열

# ── 결제 (토스페이먼츠) ──────────────────────────────
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=

# ── 구독 ────────────────────────────────────────────
SUBSCRIPTION_PRICE=5900

# ── AI 기능 (자소서 작성 지원) ──────────────────────────
# 키가 없으면 AI 기능만 꺼지고 나머지는 그대로 돕니다.
# 개인정보처리방침 제7조(국외 이전)에 이 기능을 적어 두었습니다.
# 학생 동의를 받은 경우에만 동작합니다.
# ANTHROPIC_API_KEY=sk-ant-...

# 쓸 모델. 바꾸려면 이 값만 고치면 됩니다.
AI_MODEL=claude-sonnet-4-6

# 한 번에 몇 개까지 동시에 부를지. 웹 요청이 밀리지 않게 낮게 둡니다.
AI_MAX_CONCURRENT=2

# 한 번 부를 때 기다리는 시간(초)
AI_TIMEOUT=120

# 보낼 글의 최대 길이. 너무 길면 보내지 않고 나누라고 안내합니다.
AI_MAX_INPUT=12000

# 여러 계정의 키를 함께 쓰려면(반드시 실제로 별도 사업자로 존재하는
# 정당한 계정들이어야 함) 쉼표로 나눠 적습니다. 이러면 AI_MAX_CONCURRENT도
# 자동으로 키 개수만큼 늘어납니다(명시적으로 위 값을 주면 그 값이 우선).
# ANTHROPIC_API_KEYS=sk-ant-...111,sk-ant-...222

# Anthropic 쪽이 통째로 느려지거나 실패하면, 최근 N건이 연속 실패했을 때
# 잠깐 동안 API를 아예 안 부르고 바로 "잠시 후 다시 시도해주세요"를
# 돌려줍니다(대기열이 밀리는 걸 막음). 기본값이면 충분히 보수적입니다.
# AI_CIRCUIT_FAILURE_THRESHOLD=5
# AI_CIRCUIT_WINDOW_SECONDS=60
# AI_CIRCUIT_COOLDOWN_SECONDS=30

# ── AI 작업 처리량 ────────────────────────────────────
# 이 프로세스(gunicorn 워커) 안에서 AI 작업을 몇 개씩 동시에 처리할지.
# gunicorn --workers 를 안 늘려도, 이 값만 올리면 프로세스당 처리량이
# 늘어난다(스레드라 새 프로세스를 안 띄워도 됨 — AI 호출은 네트워크
# 대기라 스레드로도 잘 병렬화된다). 기본 1.
#
# ⚠ 이 값만 올리는 건 소용없다 — 위쪽 AI_MAX_CONCURRENT(기본 2)가
# 실제 동시 Anthropic 호출 수를 다시 한번 막는 문이라, 반드시 같이
# 올려야 한다(AI_JOB_WORKERS 만큼 스레드가 떠도, 그중 AI_MAX_CONCURRENT
# 개수만 실제로 API를 부르고 나머지는 문 앞에서 기다린다).
#
# Anthropic 콘솔에서 확인한 이 조직의 실제 한도(claude-sonnet-4-6,
# claude-haiku-4-5 둘 다 분당 요청 1만 / 입력 1000만 토큰 / 출력 200만
# 토큰)라면 아래처럼 넉넉히 잡아도 API 쪽에서 막힐 일은 없다.
AI_JOB_WORKERS=15
AI_MAX_CONCURRENT=15

# DB 커넥션 풀. AI_JOB_WORKERS 를 늘리면 동시에 여는 DB 커넥션도 늘어나
# 같이 올려야 한다. 단, UDJ backend(backend/app/database.py)도 같은
# Postgres 서버를 보고 있고 그쪽도 워커 3개 × (10+20) = 최대 90개까지
# 커넥션을 열 수 있다 — 이 값까지 올리면 두 백엔드 합쳐 최악의 경우
# 100개를 넘길 수 있으니, Postgres 서버의 max_connections 을
# `SHOW max_connections;` 로 먼저 확인하고, 필요하면 postgresql.conf 에서
# 150~200 정도로 올려 두는 걸 권장한다(안 늘리면 부하가 몰릴 때 "커넥션이
# 없다"는 오류가 날 수 있다 — 코드가 죽는 게 아니라 설정 부족이다).
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=20

# AI 작업 큐 백엔드. "db"(기본)면 위 스레드 방식. "redis"로 바꾸면
# 웹서버와 완전히 분리된 별도 프로세스(`python -m app.ai_worker`, 원하는
# 만큼 띄울 수 있음)가 처리한다 — deploy/diary-ai-worker.service 참고.
# AI_QUEUE_BACKEND=db
# AI_REDIS_URL=redis://localhost:6379/0

# ── 포트폴리오 사진 저장 ─────────────────────────────
# 학생이 올리는 사진을 저장할 서버 로컬 경로. 비워두면 diary-backend
# 바로 아래 media/ 폴더를 씁니다. 배포 시 디스크 용량이 넉넉한 경로로
# 바꾸고, 이 폴더는 백업 대상에 포함해야 합니다(DB에는 파일 자체가
# 아니라 경로만 저장됩니다).
# MEDIA_ROOT=/var/lib/udj-diary/media

# 기록해 공지 알림 메일 속 링크의 사이트 주소(비우면 https://diary.ggm.kr). 메일은 SMTP_* 로 보낸다.
DIARY_SITE_URL=
