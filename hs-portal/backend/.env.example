# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.

# JWT 서명 키. 운영 전 반드시 임의 문자열로 교체
SECRET_KEY=change-me-in-production-please

# 나이스 교육정보 개방 포털 인증키 (https://open.neis.go.kr)
# 없으면 샘플키로 동작하며 교육청당 5건만 들어온다
NEIS_API_KEY=

# 카카오 REST API 키 - 주소를 좌표로 바꿀 때만 필요 (지도 뷰)
KAKAO_REST_KEY=

# 학교알리미 인증키 - 기숙사실수 자동 채우기(import_dormitory)에만 필요
# 발급: https://www.schoolinfo.go.kr → OpenAPI → 로그인(소셜) → 나의 정보 조회
SCHOOLINFO_API_KEY=

# 구글 Places API 키 - 대표 이미지 자동 채우기(import_school_photos)에만 필요
# 발급: https://console.cloud.google.com → 프로젝트 생성 → 결제 계정 연결
#      → API 및 서비스 → "Places API" 사용 설정 → 사용자 인증 정보에서 키 발급
# 비용: 학교당 검색 1회 + 사진 다운로드 1회. 검색은 사진 필드가 딸려오면
#      Enterprise+Atmosphere 요금(1000건당 $40, 월 1000건 무료), 사진 다운로드는
#      Place Photo 요금(1000건당 $7, 월 1000건 무료)이 붙는다.
GOOGLE_PLACES_API_KEY=

# 초기 관리자 계정
ADMIN_EMAIL=admin@school-portal.kr
ADMIN_PASSWORD=

# --- 문의 답변 이메일 발송 ---
# 답변 메일은 각 학교가 자기 메일 계정을 대시보드(학교 관리 → 문의 관리 → 답변 발송 메일 계정)
# 에서 직접 등록해 그 계정으로 발송합니다. 학교 비밀번호는 SECRET_KEY로 암호화되어 저장됩니다.

# --- 시스템 메일(비밀번호 재설정 인증코드 발송 등) ---
# 아래 SMTP_* 는 포털이 사용자에게 직접 보내는 시스템 메일(예: 비밀번호 찾기 코드)에 쓰입니다.
# 비워두면 비밀번호 찾기 메일이 발송되지 않고, 관리자 화면의 '비번 초기화'로 대신 처리합니다.
# 네이버 예: SMTP_HOST=smtp.naver.com / SMTP_PORT=587 / SMTP_USER=아이디(예:songjihun96, @naver.com 제외)
#           / SMTP_PASSWORD=앱비밀번호 / SMTP_FROM=songjihun96@naver.com / SMTP_SSL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=

# ---------- 본인확인 채널 ----------
# VERIFY_CHANNEL=sms    인증번호를 문자로 보낸다(SMS 설정 필요)
# VERIFY_CHANNEL=email  인증번호를 이메일로 보낸다(SMTP 설정만 있으면 된다)
# 비워두면 SMS 설정이 갖춰졌는지 보고 자동으로 고른다.
#   주의: email 채널에서는 '아이디 찾기'에 인증번호를 쓸 수 없다.
#         찾으려는 대상이 이메일 주소라서, 이름+휴대폰번호 일치로만 확인한다.
VERIFY_CHANNEL=email

# ---------- 휴대폰 본인확인(SMS) ----------
# SMS_PROVIDER 를 지정하지 않으면 실제 발송 없이 서버 로그에만 남는다(개발용).
# 운영에서는 반드시 아래 중 하나를 설정할 것.
SMS_PROVIDER=none

# 네이버 클라우드 SENS 를 쓸 때
# SMS_PROVIDER=sens
# SENS_SERVICE_ID=
# SENS_ACCESS_KEY=
# SENS_SECRET_KEY=
# SENS_SEND_NUMBER=07078677970

# 솔라피(구 CoolSMS)를 쓸 때  ★ 사업자등록증 없이 개인 계정으로 시작 가능
# 010 번호는 문자 본인인증만으로 발신번호 등록이 된다.
# SMS_PROVIDER=solapi
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SEND_NUMBER=01012345678

# 알리고를 쓸 때  (API 발급에 사업자인증이 필요할 수 있음)
# SMS_PROVIDER=aligo
# ALIGO_API_KEY=
# ALIGO_USER_ID=
# ALIGO_SEND_NUMBER=07078677970

# ---------- 결제 (토스페이먼츠) ----------
# 미설정이면 구독 신청 시 무통장 입금 안내로 대체된다.
# 주의: 토스페이먼츠 계약에는 사업자등록증과 통신판매업 신고번호가 필요하다.
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# ---------- 일지 서비스 도메인 ----------
# 서브도메인으로 분리해 띄우므로 CORS 허용 목록에 추가해야 한다.
# ALLOWED_ORIGINS=https://udjschool.ggm.kr,https://diary.ggm.kr

# ---------- 형제 서비스(기록해) 연동 ----------
# 계정의 원본은 UDJ 다. 기록해 서버가 이 키로 계정 API 를 부른다.
# diary-backend/.env 의 PARTNER_SECRET 과 똑같아야 한다.
PARTNER_SECRET=충분히-긴-무작위-문자열로-바꾸세요

# ---------- 전화 상담(콜센터) ----------
# 전화망 어댑터를 고른다. 코드에는 어떤 통신사도 하드코딩되어 있지 않다.
#   mock : 기본값. 실제 전화망 없이 순차분배·상담기록·통계를 전부 돌린다.
#          음성은 흐르지 않는다. 사업자 선정 전까지 이 값으로 둔다.
#   sip  : 실제 SIP/웹훅 사업자. 아래 값이 모두 있어야 서버가 뜬다.
PHONE_PROVIDER=mock

# PHONE_PROVIDER=sip 일 때만 필요하다.
# PHONE_API_BASE=https://api.example-telco.kr
# PHONE_API_KEY=
# PHONE_WEBHOOK_SECRET=          # 웹훅 서명 검증 키. 없으면 웹훅을 열지 않는다.
# PHONE_DID_NUMBER=              # 스마텔 010 착신전환을 받을 대표번호(070 등)
#
# 주의: 실제 010 번호나 대표번호를 코드에 적지 않는다. 이 파일과 서버 .env 에만 둔다.
#
# 스마텔 010 번호를 유지하면서 연결하는 순서
#   1) 사업자에게서 DID 번호를 받는다
#   2) 스마텔 착신전환 대상을 그 번호로 지정한다
#   3) 그 번호로 온 콜을 사업자가 /api/cs/phone/webhook/sip 으로 넘기게 설정한다
#   4) 상담원 브라우저의 음성 경로(WebRTC↔SIP)를 사업자 게이트웨이로 잇는다
#   2)와 4)는 사업자마다 되고 안 되고가 갈린다. 계약 전에 실제 통화로 확인한다.

# ---------- UDJ 홈페이지 문의 → CS 연동 ----------
# UDJ 서버가 POST /api/cs/inbound/inquiry 를 부를 때 쓰는 공유 비밀키.
# 비워두면 이 연동 자체가 닫힌다(503).
CS_INBOUND_SECRET=

# ---------- ClawOps 070 회선 (실제 전화 연결) ----------
# 아래를 채우고 PHONE_PROVIDER=clawops 로 바꾸면 실제 전화가 연결된다.
# 하나라도 비면 서버가 뜨지 않는다(반쯤 설정된 채로 전화를 놓치는 것보다 낫다).
#
# PHONE_PROVIDER=clawops
# PHONE_API_KEY=            대시보드 > 개발자 > API 키
# PHONE_ACCOUNT_ID=         대시보드 > 계정 ID
# PHONE_WEBHOOK_SECRET=     대시보드 > 개발자 > Webhook Signing Secret
# PHONE_DID_NUMBER=         발급받은 070 번호 (숫자만, 예: 07012345678)
#
# 사업자가 우리를 다시 부를 때 쓰는 공개 주소. 반드시 https 이고,
# 대시보드에 등록한 주소와 한 글자도 다르면 안 된다(서명이 어긋난다).
# PHONE_VOICE_BASE=https://udjcs.ggm.kr
#
# 대시보드 > 전화번호 > 인바운드 라우팅 > WEBHOOK 에 넣을 주소
#   https://udjcs.ggm.kr/api/cs/phone/voice/incoming
#
# 서명 검증을 끄는 스위치. 개발 중에만 쓴다.
# 운영에서 켜두면 아무나 가짜 전화를 밀어 넣을 수 있다.
# PHONE_WEBHOOK_INSECURE=0

# 브라우저(PC)로 전화를 받으려면 SIP 트렁크 부가서비스를 켜고
# (platform.claw-ops.com/addons, 계정 소유자 권한) 만든 자격증명 ID 를 넣는다.
# 비워두면 전화는 상담원 휴대폰으로 울린다(그것도 정상 동작이다).
# PHONE_SIP_CREDENTIAL_ID=
