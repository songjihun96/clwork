# ==========================================================
#  우리동네 직업계고 (ㅇㅈ) - 서버 환경변수 예시
#  이 파일을 backend/.env 로 복사해서 값을 채우세요.
#  절대로 이 파일을 그대로 두거나 git에 올리지 마세요.
# ==========================================================

# --- 필수 ---
# JWT 서명과 메일 비밀번호 암호화에 쓰는 비밀키.
# 반드시 길고 무작위한 값으로 바꾸세요. 아래 명령으로 생성 가능:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=여기에_랜덤한_64자_16진수

# PostgreSQL 접속 주소.
# 네이버 클라우드 Cloud DB for PostgreSQL 또는 서버에 직접 설치한 경우:
#   postgresql://아이디:비밀번호@호스트:5432/디비이름
DATABASE_URL=postgresql://udt:비밀번호@127.0.0.1:5432/udt

# 운영 사이트 주소(들). 쉼표로 구분. nginx로 같은 도메인이면 넣어도 되고 비워도 됨.
# 패밀리 사이트 주소를 모두 넣는다. 상담 사이트가 빠지면 화면은 뜨지만 API 가 막힌다.
# 값 뒤에 #주석을 붙이면 systemd 가 주석까지 값으로 읽는다.
ALLOWED_ORIGINS=https://udjschool.ggm.kr,https://diary.ggm.kr,https://udjcs.ggm.kr

# --- 선택: NEIS(학교 정보 수집) ---
# https://open.neis.go.kr 에서 무료 발급
NEIS_API_KEY=

# --- 선택: 카카오(주소->좌표 변환, 통학거리 계산) ---
# https://developers.kakao.com 에서 REST API 키 발급
KAKAO_REST_KEY=

# --- 선택: 시스템 발송 메일(비밀번호 재설정 등) ---
# 학교별 답변 메일은 각 학교가 대시보드에서 따로 등록합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# 일지 공유 링크에 쓰이는 사이트 주소 (선생님께 보내는 메일의 링크)
SITE_BASE_URL=https://udjschool.ggm.kr

# AI 요약 엔진 (비워두면 의존성 없는 추출 요약 사용)
# KoBART를 쓰려면 kobart 로 설정하고 아래 패키지를 설치하세요:
#   pip install torch --index-url https://download.pytorch.org/whl/cpu
#   pip install transformers
# 주의: 메모리를 많이 쓰므로 gunicorn 워커를 1개로 줄이는 것을 권장합니다.
AI_SUMMARIZER=
AI_MODEL_NAME=gogamza/kobart-summarization

# --- 선택: 본인확인 문자(SMS) ---
# 안 넣으면 인증번호가 이메일로 나갑니다(위 SMTP 설정 사용).
# sens=네이버 클라우드 SENS, aligo=알리고, solapi=솔라피, none=발송 안 함
# ※ 개인정보 처리방침의 '수탁자' 항목과 반드시 일치해야 합니다.
SMS_PROVIDER=none
VERIFY_CHANNEL=
SENS_SERVICE_ID=
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SEND_NUMBER=

# --- 선택: 영상 자동 전사(STT) ---
# 숏츠가 롱폼의 어느 구간에서 나왔는지 찾을 때 쓰는 대본을 자동으로 만듭니다.
# 비워 두면(manual) 관리자가 영상 관리 화면에서 대본을 붙여넣습니다 —
# 그 경우에도 구간 찾기는 똑같이 동작하므로, 키가 없어도 기능은 쓸 수 있습니다.
#
# clova 를 쓰려면(네이버 클라우드를 이미 쓰면 청구서가 한 곳으로 모입니다):
#   1) 네이버 클라우드 콘솔 → AI Services → CLOVA Speech → 도메인 생성
#   2) 그 도메인의 Invoke URL 과 Secret Key 를 아래에 넣습니다.
#   ※ Invoke URL 은 콘솔 값을 그대로 붙여넣으세요. 뒤에 /recognizer/upload 를
#      직접 붙이지 않습니다 — 코드가 알아서 붙입니다.
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
#
# whisper 를 쓰려면:
#   1) https://platform.openai.com 가입 후 Billing 에서 크레딧 충전
#   2) API keys → Create new secret key
#   비용은 오디오 분당 $0.006 (1시간 영상 ≈ $0.36).
#   같은 영상을 다시 받아 적지 않고 저장해 재사용합니다.
#
# 오디오 검증·전사에는 서버에 ffmpeg 가 있어야 합니다: apt install ffmpeg
# STT_PROVIDER: manual(기본) | clova | whisper | none
STT_PROVIDER=manual
OPENAI_API_KEY=
STT_MODEL=whisper-1

# ─────────────────────────────────────────────────────────────────────────────
# 서버 감시 (바탕화면 위젯이 쓰는 /api/monitor/*)
# ─────────────────────────────────────────────────────────────────────────────
# 아무 긴 문자열이면 됩니다. 만드는 법:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 비워 두면 토큰으로는 아예 안 열립니다(관리자 로그인 상태로만 열림).
MONITOR_TOKEN=
#
# 아래는 전부 생략 가능합니다. 기본값만으로 이 서버에서 돕니다.
# 자세한 설명은 tools/server-monitor/README.md 참고.
#MONITOR_UNITS=udt-backend,diary-backend,udt-audio,diary-ai-worker,nginx,postgresql
#MONITOR_BACKUP_DIRS=/root/backups,/var/backups/postgres
#MONITOR_SAMPLE_SECONDS=60
#MONITOR_HISTORY_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# 우리업무 (workwoori.ggm.kr) — 직원·협업기업 업무 시스템
# ─────────────────────────────────────────────────────────────────────────────
# 로그인 토큰 서명키. **반드시 넣으세요.** 비워 두면 백엔드를 재시작할 때마다
# 새로 만들어져서 로그인한 사람이 전부 튕깁니다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WORK_SECRET_KEY=
#
# 첫 관리자. 관리자가 하나도 없을 때만 이 값으로 하나 만듭니다.
# 이미 있으면 아무 일도 안 하므로, 만든 뒤에는 지워도 됩니다.
WORK_ADMIN_ID=
WORK_ADMIN_PASSWORD=
WORK_ADMIN_NAME=관리자
#
# 이 시각을 넘겨 첫 접속하면 '지각'으로 표시합니다.
WORK_START_TIME=09:00
# 로그인 유지 시간(시간). 기본 12시간.
#WORK_TOKEN_HOURS=12
