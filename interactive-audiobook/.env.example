# Copy to `.env` for local development. Never commit `.env`.
# Production values come from a secret manager, not from files.

# ---------- services/api ----------
ENV=development
LOG_LEVEL=INFO

# Local (outside Docker). docker-compose overrides these for containers.
DATABASE_URL=postgresql+asyncpg://audiobook:audiobook@localhost:5432/audiobook
REDIS_URL=redis://localhost:6379/0

# REQUIRED in production: >= 32 random bytes, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left unset in development, a clearly-marked insecure default is used (production refuses to start with it).
# JWT_SECRET=
JWT_ISSUER=audiobook-api
JWT_AUDIENCE=audiobook-mobile
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Social sign-in: comma-separated client IDs (public identifiers, not secrets). Empty = provider disabled (503).
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# Native apps do not need CORS. Only set for a browser-based admin tool.
CORS_ORIGINS=
# Number of reverse proxies in front of the API whose X-Forwarded-For entries are trusted.
TRUSTED_PROXY_COUNT=0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_REFRESH_PER_IP=120

SENTRY_DSN=

# Book source files, audio and images. "local" until S3/R2 (Phase 3); API and worker must share it.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=var/storage
# Time zone in which licence start/end dates are evaluated (contract dates, not UTC). Shared by API and worker.
RIGHTS_TIMEZONE=Asia/Seoul
# Storage backend: local (dev) or s3 (AWS S3 / Cloudflare R2).
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public origin of the API (local-storage media links). Must be https in production.
PUBLIC_BASE_URL=http://localhost:8000
# REQUIRED in production and different from JWT_SECRET (signs media links).
# MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=3600

# Narration. API and worker must use the same values (they form the audio cache key).
# fake = offline tones for development (rejected in production). Real providers are added per account.
TTS_PROVIDER=fake
TTS_DEFAULT_VOICE=fake-narrator
# wav (no dependencies) or aac (needs ffmpeg; the worker image has it)
AUDIO_FORMAT=wav

# Questions (RAG). API and worker must use the same embedding model: the model id is part of the row key,
# so a mismatch indexes into rows nobody queries and questions silently stop finding anything.
# fake = offline, deterministic, lexical (rejected in production).
LLM_PROVIDER=fake
LLM_MODEL=fake-story-v1
# LLM_BASE_URL=https://...        # hosted endpoint or http://vllm:8000/v1
# LLM_API_KEY=
# Set only if the endpoint supports guided decoding (response_format=json_schema).
LLM_SUPPORTS_JSON_SCHEMA=false
LLM_TIMEOUT_S=30
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=hashing-bigram-v1
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Instruction prefixes for asymmetric models (bge-m3 style). Leave empty for symmetric ones.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# Questions cost money per call, so they are limited per account, not per IP.
QUESTION_RATE_LIMIT_PER_MINUTE=12

# Admin book uploads (bytes). Also cap request bodies at the reverse proxy.
BOOK_UPLOAD_MAX_BYTES=52428800

# ---------- docker-compose postgres ----------
POSTGRES_USER=audiobook
POSTGRES_PASSWORD=audiobook
POSTGRES_DB=audiobook

# ---------- apps/mobile (bundled into the app: PUBLIC values only, never secrets) ----------
# Android emulator reaches the host machine at 10.0.2.2; a physical device needs your PC's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Talk mode (LiveKit, Phase 5). Empty = Talk mode disabled (the endpoint answers 503) and Listen mode
# keeps working. LIVEKIT_URL is the URL the *client* dials, so in Docker it stays the host-reachable one
# (ws://127.0.0.1:7880) while the agent container overrides it with the internal ws://livekit:7880.
# Local server:  docker compose --profile realtime up -d livekit ai-agent
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecretsecret
REALTIME_AGENT_NAME=story-agent
REALTIME_TOKEN_TTL_SECONDS=600
REALTIME_RATE_LIMIT_PER_MINUTE=10

# Realtime agent (services/ai-agent, Phase 6). Names shared with the API and worker on purpose: a mismatch
# in TTS_* would make Talk mode re-synthesise narration the Listen path already paid for, and a mismatch in
# EMBEDDING_MODEL would make spoken questions search rows nobody indexed.
STT_PROVIDER=fake
# What the offline STT "hears", in order. Pipe-separated so an entry can contain commas.
STT_FAKE_SCRIPT=하람은 누구야|멈춰
# The small intent classifier costs one model call per ambiguous utterance; off until a real endpoint exists.
INTENT_CLASSIFIER_ENABLED=false

# ---------- Later phases (not used yet) ----------
# INTENT_LLM_PROVIDER=    # Phase 6 (a smaller model for intent classification)
# SCENE_LLM_PROVIDER=     # Phase 8 (structured scene analysis)
# STT_PROVIDER=           # Phase 6
# IMAGE_PROVIDER=         # Phase 9
# VOICE_PROVIDER=         # Phase 10
# STORAGE_BUCKET=
# STORAGE_ENDPOINT_URL=
